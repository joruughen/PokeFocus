{
  "name": "pokefocus",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n client,server -c cyan,magenta \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "DEV_TOOLS=1 tsx watch --clear-screen=false server/index.ts",
    "start": "NODE_ENV=production tsx server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.server.json",
    "import:pokeapi": "tsx scripts/import-pokeapi.ts",
    "build:data": "tsx scripts/build-data.ts",
    "download:sprites": "tsx scripts/download-sprites.ts",
    "simulate": "tsx scripts/simulate.ts",
    "simulate:damage": "tsx scripts/simulate-damage.ts",
    "db:generate": "drizzle-kit generate",
    "vapid": "tsx scripts/generate-vapid.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@electric-sql/pglite": "^0.5.15",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/jersey-10": "^5.3.0",
    "@fontsource/tiny5": "^5.3.0",
    "@hono/node-server": "^2.1.6",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "i18next": "^26.7.1",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.12",
    "tsx": "^4.23.15",
    "web-push": "^3.6.7",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^9.2.5",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
