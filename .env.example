# Copy to .env (loaded automatically by server/index.ts). All optional in development.

# development | production | test (npm start always sets production)
# NODE_ENV=development
PORT=8787

# PostgreSQL connection. Leave empty to use embedded PGlite (no Docker needed).
DATABASE_URL=
# PGlite data directory when DATABASE_URL is empty (`memory://` = in memory).
PGLITE_DIR=.data/pglite

# Allowed Origin(s) for non-GET requests, comma-separated.
# Dev: the Vite URL. Production: the public https URL (e.g. https://pokefocus.example).
APP_ORIGIN=http://localhost:5173

# 1 = accept x-dev-now / x-dev-seed headers and dev* actions. Forced to 0 in production.
DEV_TOOLS=0

# 1 = behind a reverse proxy: rate limits use the last X-Forwarded-For hop.
TRUST_PROXY=0

# Built client served by the API in production.
STATIC_DIR=dist

# docker compose only
# Host port for the app (change it if 8787 is taken) and bind address (127.0.0.1 = local only).
APP_PORT=8787
APP_BIND=127.0.0.1
# Required by docker compose. Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=
